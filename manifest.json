{
  "manifest_version": 3,
  "name": "拾片 - 视频素材下载",
  "version": "1.1.0",
  "description": "给做自媒体的人用：在 B站、抖音、小红书、快手、微博上直接下载视频、图片、封面和字幕，支持批量下载和作品数据表。不登录、不限次数，全部在本机浏览器里完成。",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾片",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.youtube.com/*",
        "https://*.kuaishou.com/*",
        "https://weibo.com/*",
        "https://*.weibo.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://*.bilibili.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.rednote.com/*",
        "https://*.kuaishou.com/*",
        "https://weibo.com/*",
        "https://*.weibo.com/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "batch.html",
        "icons/*"
      ],
      "matches": [
        "https://www.douyin.com/*",
        "https://*.bilibili.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.rednote.com/*",
        "https://*.kuaishou.com/*",
        "https://weibo.com/*",
        "https://*.weibo.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
